# Free and public-safe default setup
# This app works without private credentials by using a local SQLite database and fallback learning responses.
DATABASE_URL=sqlite:///./priya_mentor.db

# Local Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Frontend origin for CORS; set this to your Vercel URL when deployed
FRONTEND_URL=http://localhost:5173
